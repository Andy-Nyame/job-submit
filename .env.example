# Neon PostgreSQL: pooled runtime and direct migration connections.
# Use sslmode=verify-full and keep both URLs scoped to the dedicated JobSubmit database.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Supabase Auth project API configuration. The anon key is intentionally public;
# never place a service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stable 32-byte base64 key for Server Action references during rolling deploys.
# Generate securely; never reuse a public example value or expose it to clients.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional canonical origin for printed and pickup QR links.
APP_ORIGIN=https://capt-bob-cedis-artworks.vercel.app

# At least 32 random characters. Encrypts retrievable one-time pickup credentials.
PICKUP_CREDENTIAL_SECRET=

# Keep disabled until production custom SMTP and confirmation templates are ready.
EMAIL_PASSWORD_SIGNUP_ENABLED=false

# Vercel Blob server credential. Never expose this through NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

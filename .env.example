# Pooled/runtime PostgreSQL connection for the dedicated JobSubmit database.
DATABASE_URL="postgresql://JOBSUBMIT_USER:CHANGE_ME@JOBSUBMIT_HOST:5432/jobsubmit?sslmode=require"

# Direct PostgreSQL connection used only by Prisma migrations and administrative tooling.
# For a local non-pooled database this may be the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://JOBSUBMIT_USER:CHANGE_ME@JOBSUBMIT_HOST:5432/jobsubmit?sslmode=require"
